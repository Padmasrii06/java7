/**
 * @param {number} n
 * @return {number}
 */
var climbStairs = function(n) {
    if(n === 1) return 1;
    if(n === 2) return 2;
    if(n === 3) return 3;


    let arr  = [];
    arr[1] = 1;
    arr[2] = 2;
    arr[3] = 3; 

    for(let i=3;i<n;i++){
        arr[i+1] = arr[i] + arr[i-1]; 
    }

    return arr.pop();
};
